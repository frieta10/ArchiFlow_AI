
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Identity & Access

model User {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email          String    @unique
  name           String?
  password_hash  String?
  auth_provider  String?
  status         String?   @default("active") // Check constraint in DB
  last_login_at  DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  workspacesOwned  Workspace[]
  workspaceMembers WorkspaceMember[]
  projectsCreated  Project[]
  diagramsCreated  Diagram[]
  assetsUploaded   Asset[]
  llmConnections   LLMConnection[]
  aiJobsRequested  AIJob[]
  docsCreated      Document[]
  docVersions      DocumentVersion[]
  auditEvents      AuditEvent[]
  diagramVersions  DiagramVersion[]

  @@map("users")
}

model Workspace {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String
  owner_user_id String?   @db.Uuid
  plan_tier    String?   @default("free")
  status       String?   @default("active")
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  owner        User?     @relation(fields: [owner_user_id], references: [id])
  members      WorkspaceMember[]
  apiKeys      ApiKey[]
  projects     Project[]
  assets       Asset[]
  llmKeys      LLMConnection[]
  aiJobs       AIJob[]
  templates    PromptTemplate[]
  auditEvents  AuditEvent[]
  retention    DataRetentionPolicy?

  @@map("workspaces")
}

model WorkspaceMember {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspace_id String   @db.Uuid
  user_id      String   @db.Uuid
  role         String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@map("workspace_members")
}

model ApiKey {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspace_id String    @db.Uuid
  label        String?
  hashed_key   String
  scopes       Json?
  revoked_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// 2. Project & Collaboration

model Project {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspace_id String    @db.Uuid
  name         String
  description  String?
  status       String?   @default("active")
  created_by   String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  creator      User?     @relation(fields: [created_by], references: [id])
  members      ProjectMember[]
  assets       Asset[]
  diagrams     Diagram[]
  aiJobs       AIJob[]
  documents    Document[]
  auditEvents  AuditEvent[]

  @@index([workspace_id])
  @@map("projects")
}

model ProjectMember {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  project_id String   @db.Uuid
  user_id    String   @db.Uuid
  role       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@map("project_members")
}

// 3. Assets & Extraction

model Asset {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspace_id   String    @db.Uuid
  project_id     String?   @db.Uuid
  type           String?
  filename       String
  mime_type      String?
  size_bytes     BigInt?
  storage_bucket String
  storage_key    String
  checksum_sha256 String?
  uploaded_by    String?   @db.Uuid
  uploaded_at    DateTime  @default(now()) @db.Timestamptz(6)

  workspace      Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  project        Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  uploader       User?     @relation(fields: [uploaded_by], references: [id])
  extractions    AssetExtraction[]
  diagramInputs  DiagramInput[]
  diagramVersionsRef DiagramVersion[] // For render_output_asset_id

  @@index([project_id, uploaded_at(sort: Desc)])
  @@map("assets")
}

model AssetExtraction {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  asset_id        String   @db.Uuid
  extraction_type String?
  content_text    String?
  status          String?
  error_message   String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  asset           Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@map("asset_extractions")
}

// 4. Diagram Management

model Diagram {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  project_id         String    @db.Uuid
  title              String
  diagram_type       String?
  source_mode        String?
  current_version_id String?   @db.Uuid
  created_by         String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)

  project            Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  creator            User?     @relation(fields: [created_by], references: [id])
  currentVersion     DiagramVersion? @relation("CurrentVersion", fields: [current_version_id], references: [id])
  versions           DiagramVersion[] @relation("DiagramToVersions")

  @@index([project_id, updated_at(sort: Desc)])
  @@map("diagrams")
}

model DiagramVersion {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  diagram_id            String    @db.Uuid
  version_no            Int
  spec_format           String?
  spec_text             String
  render_status         String?
  render_output_asset_id String?  @db.Uuid
  created_by            String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz(6)

  diagram               Diagram   @relation("DiagramToVersions", fields: [diagram_id], references: [id], onDelete: Cascade)
  currentForDiagram     Diagram[] @relation("CurrentVersion")
  renderOutput          Asset?    @relation(fields: [render_output_asset_id], references: [id])
  creator               User?     @relation(fields: [created_by], references: [id])
  inputs                DiagramInput[]

  @@unique([diagram_id, version_no])
  @@index([diagram_id, version_no(sort: Desc)])
  @@map("diagram_versions")
}

model DiagramInput {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  diagram_version_id String    @db.Uuid
  input_type         String?
  asset_id           String?   @db.Uuid
  prompt_text        String?
  order_no           Int

  version            DiagramVersion @relation(fields: [diagram_version_id], references: [id], onDelete: Cascade)
  asset              Asset?         @relation(fields: [asset_id], references: [id])

  @@map("diagram_inputs")
}

// 5. AI Orchestration

model LLMProvider {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String
  provider_type    String?
  is_active        Boolean   @default(true)
  default_provider Boolean?  @default(false)

  connections      LLMConnection[]
  jobSteps         AIJobStep[]

  @@map("llm_providers")
}

model LLMConnection {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspace_id     String    @db.Uuid
  provider_id      String    @db.Uuid
  connection_name  String?
  auth_type        String?
  token_encrypted  String?
  secret_ref       String?
  token_expires_at DateTime? @db.Timestamptz(6)
  status           String?
  created_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  workspace        Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  provider         LLMProvider @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  creator          User?      @relation(fields: [created_by], references: [id])

  @@map("llm_connections")
}

model AIJob {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspace_id String    @db.Uuid
  project_id   String    @db.Uuid
  job_type     String?
  status       String?
  priority     Int       @default(5)
  requested_by String?   @db.Uuid
  started_at   DateTime? @db.Timestamptz(6)
  finished_at  DateTime? @db.Timestamptz(6)
  error_message String?
  correlation_id String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  project      Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requester    User?     @relation(fields: [requested_by], references: [id])
  steps        AIJobStep[]
  generatedDocVersions DocumentVersion[]

  @@index([project_id, status, created_at(sort: Desc)])
  @@map("ai_jobs")
}

model AIJobStep {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  job_id         String    @db.Uuid
  step_no        Int
  step_type      String?
  status         String?
  provider_id    String?   @db.Uuid
  model_name     String?
  tokens_in      Int?
  tokens_out     Int?
  cost_estimate  Decimal?  @db.Decimal(12, 6)
  input_snapshot Json?
  output_snapshot Json?
  started_at     DateTime? @db.Timestamptz(6)
  finished_at    DateTime? @db.Timestamptz(6)

  job            AIJob     @relation(fields: [job_id], references: [id], onDelete: Cascade)
  provider       LLMProvider? @relation(fields: [provider_id], references: [id])

  @@map("ai_job_steps")
}

model PromptTemplate {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspace_id     String?   @db.Uuid
  name             String
  purpose          String?
  template_text    String
  variables_schema Json?
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  workspace        Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("prompt_templates")
}

// 6. Documents

model Document {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  project_id         String    @db.Uuid
  doc_type           String?
  title              String
  current_version_id String?   @db.Uuid
  created_by         String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)

  project            Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  creator            User?     @relation(fields: [created_by], references: [id])
  currentVersion     DocumentVersion? @relation("CurrentDocVersion", fields: [current_version_id], references: [id])
  versions           DocumentVersion[] @relation("DocToVersions")

  @@map("documents")
}

model DocumentVersion {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  document_id        String    @db.Uuid
  version_no         Int
  content_format     String?
  content_text       String
  generated_by_job_id String?  @db.Uuid
  created_by         String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  document           Document  @relation("DocToVersions", fields: [document_id], references: [id], onDelete: Cascade)
  currentForDoc      Document[] @relation("CurrentDocVersion")
  job                AIJob?    @relation(fields: [generated_by_job_id], references: [id])
  creator            User?     @relation(fields: [created_by], references: [id])

  @@unique([document_id, version_no])
  @@map("document_versions")
}

// 7. Governance & Audit

model AuditEvent {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspace_id   String?   @db.Uuid
  project_id     String?   @db.Uuid
  actor_user_id  String?   @db.Uuid
  event_type     String?
  entity_type    String?
  entity_id      String?   @db.Uuid
  event_time     DateTime  @default(now()) @db.Timestamptz(6)
  ip_address     String?
  user_agent     String?
  metadata       Json?

  workspace      Workspace? @relation(fields: [workspace_id], references: [id])
  project        Project?   @relation(fields: [project_id], references: [id])
  actor          User?      @relation(fields: [actor_user_id], references: [id])

  @@index([workspace_id, event_time(sort: Desc)])
  @@map("audit_events")
}

model DataRetentionPolicy {
  workspace_id       String @id @db.Uuid
  asset_retention_days Int?
  logs_retention_days  Int?
  version_retention_days Int?

  workspace          Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("data_retention_policies")
}
